# Create a bot with @BotFather in Telegram and paste its HTTP API token here.
TELEGRAM_BOT_TOKEN=123456:replace-with-your-token
# Terminal-only JSON source. Save a session with npm run reddit:session-check.
# Verify with npm run reddit:json-check. HTML fallback: REDDIT_SOURCE=html.
REDDIT_SOURCE=json
# Session file; the default is excluded from Git.
REDDIT_HTML_COOKIE_FILE=data/reddit-session.txt
# Legacy RSS source: set REDDIT_SOURCE=rss only while feeds are still available.
# Optional: the newest-posts Atom feed for the subreddit being monitored.
REDDIT_RSS_URL=https://www.reddit.com/r/fragranceswap/new/.rss
# Recommended on hosted deployments: copy the user and feed values from a private
# RSS URL at https://www.reddit.com/prefs/feeds/. Treat the feed token as a secret.
# REDDIT_RSS_USER=your_reddit_username
# REDDIT_RSS_TOKEN=replace-with-your-private-feed-token
# Optional descriptive identity sent with RSS requests.
# REDDIT_USER_AGENT=node:scentinel:v0.1.0 (by /u/your_reddit_username)
# Optional. Defaults to 90 seconds; shorter intervals are clamped to this minimum.
POLL_INTERVAL_MS=90000
# Optional local dashboard/API port. Exposes /health, /api/listings, and /api/market.
PORT=3000
# Optional persistent file location. Suitable for one instance; mount this path in deployment.
# STORE_FILE=data/store.json
